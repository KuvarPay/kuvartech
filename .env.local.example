# Sanity — create a project at sanity.io/manage, then fill these in
# and copy this file to .env.local
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01

# Server-only. Needed for draft previews, not for published reads.
SANITY_API_READ_TOKEN=

# Shared secret for the publish webhook -> /api/revalidate
# Generate with: openssl rand -base64 32
SANITY_REVALIDATE_SECRET=
